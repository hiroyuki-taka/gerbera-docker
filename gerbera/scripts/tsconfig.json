{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "es2015"
    ],
    "baseUrl": "./",
    "rootDirs": [
      "./src"
    ],
    "typeRoots": [
      "./types"
    ],
    "outDir": "./custom/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/*.ts"
  ]
}
